# Configuración de Entorno para blackbox-lab
# COPIA ESTE ARCHIVO A .env Y RELLENA CON TUS CLAVES (NUNCA SUBAS .env A GIT)

# Clave de API para el proveedor de modelos o API de evaluación
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Entorno de ejecución (development / test / production)
ENVIRONMENT=development

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Límite global de presupuesto en dólares para desarrollo local
MAX_BUDGET_USD=5.00
